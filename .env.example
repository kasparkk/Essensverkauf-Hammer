SESSION_SECRET="change-me-to-a-long-random-string"

# Nur für lokale Entwicklung ohne "netlify dev" nötig - eine Postgres-Verbindung.
# Bei Deployment auf Netlify wird die Datenbank automatisch über
# Netlify DB bereitgestellt, diese Variable wird dann nicht benötigt.
DATABASE_URL="postgresql://user:password@localhost:5432/mitbring"
